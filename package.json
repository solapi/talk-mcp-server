{
  "name": "@solapi/talk-mcp-server",
  "version": "1.0.2",
  "description": "솔라피톡 상담을 AI 에이전트 도구로 다루는 MCP 서버 (stdio 기본, --http 옵션)",
  "license": "MIT",
  "type": "module",
  "bin": {
    "talk-mcp-server": "dist/index.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint . && tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "solapi",
    "mcp",
    "talk",
    "model-context-protocol"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@semantic-release/exec": "^7.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.5",
    "@semantic-release/npm": "^13.1.5",
    "@types/node": "^20.19.43",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^9.39.5",
    "semantic-release": "^24.2.7",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solapi/talk-mcp-server.git"
  },
  "homepage": "https://github.com/solapi/talk-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/solapi/talk-mcp-server/issues"
  }
}
